PORT=8000
NODE_ENV=development
API_PREFIX=api/v1
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# PostgreSQL connection string
DATABASE_URL="postgresql://user:password@localhost:5432/theieltsfoundation"

# Auth
# Sinh secret: openssl rand -hex 32
JWT_ACCESS_SECRET=change-me-to-a-random-string-of-at-least-32-chars
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=7

# Mail (bỏ trống SMTP_HOST thì OTP được in ra console khi dev)
MAIL_FROM="The IELTS Foundation <no-reply@theieltsfoundation.com>"
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=app-password
