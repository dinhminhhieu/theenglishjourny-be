PORT=8000
NODE_ENV=development
API_PREFIX=api/v1
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# PostgreSQL connection string
# Khớp với docker-compose.yml (docker compose up -d)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/theenglishjourney"

# Auth
# Sinh secret: openssl rand -hex 32
JWT_ACCESS_SECRET=change-me-to-a-random-string-of-at-least-32-chars
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=7

# Mail (bỏ trống SMTP_HOST thì OTP được in ra console khi dev)
MAIL_FROM="The English Journey <no-reply@theenglishjourney.com>"
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=app-password

# Object storage: Cloudflare R2. Lấy Account ID, Access Key ID, Secret ở R2 → Manage API tokens.
# Bucket ảnh bật Public access (r2.dev cho dev, tên miền riêng cho production) rồi dán địa chỉ vào S3_PUBLIC_BASE_URL.
S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_BUCKET=theenglishjourney-dev-public
S3_PRIVATE_BUCKET=theenglishjourney-dev-private
S3_PUBLIC_BASE_URL=https://pub-<ID>.r2.dev
# MinIO local (docker compose --profile minio up -d):
# S3_ENDPOINT=http://localhost:9000
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=minioadmin
# S3_SECRET_ACCESS_KEY=minioadmin
# S3_PUBLIC_BUCKET=theenglishjourney-public
# S3_PRIVATE_BUCKET=theenglishjourney-private
# S3_PUBLIC_BASE_URL=http://localhost:9000/theenglishjourney-public
S3_PRESIGN_PUT_TTL_SECONDS=900
S3_PRESIGN_GET_TTL_SECONDS=7200

# Bài làm: số giây cho nộp trễ sau khi hết giờ, số bài tối đa bắt đầu trong 24 giờ
ATTEMPT_GRACE_SECONDS=30
ATTEMPT_DAILY_LIMIT=50
